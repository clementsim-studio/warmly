VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — client-side GA4. Analytics only load when this is set AND the
# build is production (import.meta.env.PROD). Leave blank to disable
# entirely, e.g. local dev and Vercel preview deploys.
VITE_GA4_MEASUREMENT_ID=

# Server-side only (api/feedback.js) — never prefix these with VITE_, or
# they'd get bundled into the client-side JS.
SUPABASE_SERVICE_ROLE_KEY=
IP_HASH_SALT=
